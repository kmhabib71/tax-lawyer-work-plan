  "surcharge_structures": {
    "2024-25": {
      "wealth_based_surcharge": {
        "description": "Surcharge based on net wealth of taxpayer",
        "legal_reference": "Circular 2024-25 Topic 7",
        "applicable_to": ["individual", "hindu_undivided_family", "firm"],
        "minimum_threshold": "40000000",
        "slabs": [
          {
            "net_wealth_range": {
              "min": "40000000",
              "max": "100000000"
            },
            "surcharge_rate": "0.10",
            "description": "10% surcharge on tax for net wealth 4-10 crore BDT"
          },
          {
            "net_wealth_range": {
              "min": "100000001",
              "max": "250000000"
            },
            "surcharge_rate": "0.15",
            "description": "15% surcharge on tax for net wealth 10-25 crore BDT"
          },
          {
            "net_wealth_range": {
              "min": "250000001",
              "max": null
            },
            "surcharge_rate": "0.25",
            "description": "25% surcharge on tax for net wealth above 25 crore BDT"
          }
        ]
      },

      "environmental_surcharge": {
        "description": "Environmental surcharge on companies",
        "legal_reference": "Circular 2024-25 Topic 8",
        "applicable_to": ["company"],
        "rate": "0.01",
        "description": "1% environmental surcharge on income tax",
        "conditions": ["All companies except those specifically exempted"]
      }
    }
  },

  "exemption_structures": {
