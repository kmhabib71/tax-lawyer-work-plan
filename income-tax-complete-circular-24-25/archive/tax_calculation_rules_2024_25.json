        "conditions": ["Located in approved economic zone", "Export oriented", "Minimum investment"]
      },

      "hi_tech_parks": {
        "description": "Tax benefits for hi-tech park enterprises",
        "legal_reference": "Circular 2024-25 Topics 18-20",
