            "formula_type": "progressive_tax_calculation",
            "description": "Individual income tax calculation for 2024-25",
            "input_parameters": ["total_income", "taxpayer_type"],
            "calculation_steps": [
              {
                "step": 1,
                "condition": "income <= 350000",
                "calculation": "tax = 0",
                "rate": 0
              },
              {
                "step": 2,
                "condition": "350000 < income <= 450000",
                "calculation": "tax = (income - 350000) * 0.05",
                "rate": 5
              },
              {
                "step": 3,
                "condition": "450000 < income <= 750000", 
                "calculation": "tax = 5000 + (income - 450000) * 0.10",
                "rate": 10
              },
              {
                "step": 4,
                "condition": "750000 < income <= 1150000",
                "calculation": "tax = 35000 + (income - 750000) * 0.15",
                "rate": 15
              },
              {
                "step": 5,
                "condition": "1150000 < income <= 1650000",
                "calculation": "tax = 95000 + (income - 1150000) * 0.20",
                "rate": 20
              },
              {
                "step": 6,
                "condition": "income > 1650000",
                "calculation": "tax = 195000 + (income - 1650000) * 0.25",
                "rate": 25
              }
            ],
            "validation_rules": [
              "income >= 0",
              "taxpayer_type in ['individual', 'hindu_undivided_family', 'firm']"
            ]
          }
        ],
