# Environment Variables for AI Tax Calculator Bangladesh

# Tax Engine Configuration
TAX_ENGINE_VERSION=2024.25
CALCULATION_TIMEOUT=30000
MAX_CALCULATION_RETRIES=3

# API Configuration
API_BASE_URL=http://localhost:3000
API_VERSION=v1

# Development Settings
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# FACEBOOK_PIXEL_ID=123456789

# Database (Future Enhancement)
# DATABASE_URL=postgresql://user:password@localhost:5432/tax_calculator
# REDIS_URL=redis://localhost:6379

# External Services (Future Enhancement)  
# NBR_API_KEY=your_nbr_api_key_here
# PAYMENT_GATEWAY_KEY=your_payment_key_here

# Security
# JWT_SECRET=your_jwt_secret_here
# ENCRYPTION_KEY=your_encryption_key_here

# Email Service (Future Enhancement)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# File Storage (Future Enhancement)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=tax-calculator-files
# AWS_REGION=ap-southeast-1

# Monitoring & Logging (Future Enhancement)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# LOG_LEVEL=info

# Rate Limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000

# Feature Flags (Future Enhancement)
# ENABLE_USER_ACCOUNTS=false
# ENABLE_PAYMENT_INTEGRATION=false
# ENABLE_ADVANCED_FEATURES=false
# ENABLE_MULTILINGUAL=true

# Development Tools
# ANALYZE_BUNDLE=false
# DISABLE_SOURCE_MAPS=false