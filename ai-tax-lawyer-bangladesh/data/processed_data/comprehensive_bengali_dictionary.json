        "কেমন\\s+(হার|রেট)",
        "কতটুকু\\s+(দিতে|পরিশোধ)"
      ],
      "form_questions": [
        "কোন\\s+(ফরম|ফর্ম)",
        "কি\\s+(ফরম|ফর্ম)",
        "কী\\s+(দাখিল|জমা)",
