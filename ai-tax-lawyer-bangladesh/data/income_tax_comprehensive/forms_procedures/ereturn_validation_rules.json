      }
    }
  },
  "form_workflow": {
    "step_sequence": [
      "assessment_information",
      "additional_information",
      "income_details_by_source",
      "rebate_investments", 
      "expenditure_lifestyle",
      "assets_liabilities",
      "tax_computation",
      "payment_details",
      "verification_submission"
    ],
    "validation_checkpoints": [
      "After income entry - validate totals",
      "After rebate entry - validate limits", 
      "After asset entry - check IT-10B requirements",
      "After expense entry - check IT-10BB requirements",
      "Before submission - comprehensive validation"
    ]
  }
}