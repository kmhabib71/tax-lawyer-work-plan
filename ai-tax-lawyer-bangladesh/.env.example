# Database Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DATABASE=ai_tax_lawyer_bd
MONGODB_TEST_DATABASE=ai_tax_lawyer_bd_test

# RAGFlow Configuration
RAGFLOW_API_URL=http://localhost:9380
RAGFLOW_API_KEY=your_ragflow_api_key
RAGFLOW_KNOWLEDGE_BASE=bd_tax_law_kb

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.1

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_DEBUG=True
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SENTRY_DSN=your_sentry_dsn_here

# Agent Configuration
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT=30
AGENT_RETRY_ATTEMPTS=3

# Performance Configuration
MAX_QUERY_LENGTH=10000
MAX_RESPONSE_LENGTH=50000
RATE_LIMIT_PER_MINUTE=100

# Development Configuration
ENVIRONMENT=development
DEBUG_AGENTS=True
ENABLE_METRICS=True

# Bengali Language Configuration
BENGALI_MODEL_PATH=models/bengali_nlp
TRANSLATION_API_KEY=your_translation_api_key

# Form Processing Configuration
FORM_UPLOAD_MAX_SIZE=10485760  # 10MB
SUPPORTED_FORMATS=pdf,docx,xlsx

# Legal Document Configuration
LEGAL_DOCS_PATH=data/legal_documents/
EMBEDDINGS_CACHE_PATH=data/embeddings/
PROCESSED_DATA_PATH=data/processed_data/